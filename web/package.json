{
  "name": "bimurix-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "seed": "node --env-file-if-exists=.env.local scripts/seed-sanity.mts",
    "sanity:types": "sanity schema extract --path src/sanity/schema.json && sanity typegen generate",
    "seed:login": "sanity exec scripts/seed-sanity.mts --with-user-token -- --cli-session",
    "db:env": "node scripts/db-env.mjs",
    "admin:add": "node --env-file=.env.development.local scripts/add-admin.mjs"
  },
  "dependencies": {
    "@sanity/client": "^8.14.1",
    "@sanity/image-url": "^2.1.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.5",
    "next-sanity": "^13.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanity": "^6.21.0",
    "styled-components": "^6.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "supabase": "^3.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.14.0"
}
